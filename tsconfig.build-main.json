{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "src/main/**/*",
    "src/security/**/*",
    "src/logging/**/*",
    "src/monitoring/**/*",
    "src/recovery/**/*",
    "src/updates/**/*",
    "src/build/**/*",
    "src/deployment/**/*",
    "src/release/**/*"
  ]
}
