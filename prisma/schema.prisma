// Prisma schema for Shivi AI production memory backend
// Designed for Neon PostgreSQL with hybrid local-first support

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String              @id @default(uuid())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  externalId           String?             @unique
  displayName          String?
  email                String?             @unique
  language             String              @default("hi")
  preferences          Json                @default("{}")
  settings             Json                @default("{}")
  rowLevelSecurity     Boolean             @default(false)
  sessions             Session[]
  reminders            Reminder[]
  googleCalendarToken  GoogleCalendarToken?
  googleCalendarEvents GoogleCalendarEvent[]
  auditLogs            AuditLog[]
  conversations        Conversation[]
  appActivities        AppActivity[]
  interactionHistories InteractionHistory[]
  permissions          Permission[]
  emotionalContexts    EmotionalContext[]
  settingRecords       Setting[]
}

model Session {
  id                   String               @id @default(cuid())
  user                 User                 @relation(fields: [userId], references: [id])
  userId               String
  startedAt            DateTime             @default(now())
  endedAt              DateTime?
  metadata             Json?
  conversations        Conversation[]
  settings             Setting[]
  interactionHistories InteractionHistory[]
}

model Conversation {
  id              String            @id @default(cuid())
  user            User              @relation(fields: [userId], references: [id])
  userId          String
  session         Session           @relation(fields: [sessionId], references: [id])
  sessionId       String
  title           String?
  personalityMode String
  emotionalContext String?
  topics          String[]          @default([])
  entities        Json?
  sentiment       Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        Message[]
  embeddings      MemoryEmbedding[]
  auditLogs       AuditLog[]
  reminders       Reminder[]
  emotionalContexts EmotionalContext[]
}

model Message {
  id             String   @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())
  metadata       Json?
  sentiment      Float?
}

model EmotionalContext {
  id             String        @id @default(cuid())
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?
  mood           String
  intensity      Float
  triggers       String[]
  adaptation     Json?
  lastObserved   DateTime      @default(now())
  metadata       Json?
}

model Reminder {
  id                 String        @id @default(cuid())
  user               User          @relation(fields: [userId], references: [id])
  userId             String
  conversation       Conversation? @relation(fields: [conversationId], references: [id])
  conversationId     String?
  title              String
  description        String?
  dueAt              DateTime?
  recurring          Json?
  completed          Boolean       @default(false)
  priority           String        @default("medium")
  emotionalPreference String?
  calendarMetadata   Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  syncedAt           DateTime?
  metadata           Json?
  schedules          ReminderSchedule[]
  notifications      ReminderNotification[]
  contexts           ReminderContext[]
}

model ReminderSchedule {
  id            String     @id @default(cuid())
  reminder      Reminder   @relation(fields: [reminderId], references: [id])
  reminderId    String
  scheduleType  String     // 'once', 'daily', 'weekly', 'monthly', 'custom'
  nextDueAt     DateTime?
  lastTriggered DateTime?
  rule          Json?      // recurrence rule
  timezone      String     @default("Asia/Kolkata")
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model ReminderNotification {
  id            String     @id @default(cuid())
  reminder      Reminder   @relation(fields: [reminderId], references: [id])
  reminderId    String
  notificationType String  // 'desktop', 'inapp', 'voice'
  status        String     @default("pending") // 'pending', 'sent', 'failed', 'snoozed'
  sentAt        DateTime?
  snoozedUntil  DateTime?
  metadata      Json?
  createdAt     DateTime   @default(now())
}

model ReminderContext {
  id            String     @id @default(cuid())
  reminder      Reminder   @relation(fields: [reminderId], references: [id])
  reminderId    String
  contextType   String     // 'conversation', 'location', 'time', 'activity'
  trigger       String
  conditions    Json?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
}

model GoogleCalendarToken {
  id            String     @id @default(cuid())
  user          User       @relation(fields: [userId], references: [id])
  userId        String     @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  scope         String[]
  calendarId    String?    // default calendar ID
  syncEnabled   Boolean    @default(false)
  lastSyncAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model GoogleCalendarEvent {
  id            String     @id
  user          User       @relation(fields: [userId], references: [id])
  userId        String
  googleId      String     @unique
  summary       String
  description   String?
  startTime     DateTime
  endTime       DateTime?
  timezone      String
  location      String?
  status        String
  recurrence    Json?
  reminders     Json?
  syncedAt      DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model AppActivity {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  activityType String
  platform  String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Permission {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  permissionType String
  granted        Boolean  @default(false)
  source         String?
  createdAt      DateTime @default(now())
}

model MemoryEmbedding {
  id             String        @id @default(cuid())
  memoryType     String
  memoryId       String
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?
  embedding      Float[]       @default([])
  summary        String?
  keywords       String[]      @default([])
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model InteractionHistory {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?
  session      Session? @relation(fields: [sessionId], references: [id])
  sessionId    String?
  activityType String
  referenceId  String?
  action       String
  userInput    String?
  systemOutput String?
  metadata     Json?
  createdAt    DateTime @default(now())
}

model Setting {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?
  session      Session? @relation(fields: [sessionId], references: [id])
  sessionId    String?
  key          String
  value        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, key], name: "userId_key")
}

model AuditLog {
  id             String        @id @default(cuid())
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?
  action         String
  details        Json?
  source         String?
  createdAt      DateTime      @default(now())
}

model SyncQueueItem {
  id          String   @id @default(cuid())
  itemType    String
  itemId      String
  action      String
  payload     Json
  status      String   @default("pending")
  retryCount  Int      @default(0)
  lastAttempt DateTime?
  nextAttempt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
