{
  "name": "shivi-ai",
  "version": "0.1.0",
  "description": "Shivi AI - Hindi-first, emotionally intelligent, privacy-first local AI assistant",
  "main": "dist/main/main.js",
  "homepage": "./",
  "author": "Namaste Codes",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "cross-env NODE_ENV=development npm run build:main && npx wait-on http://127.0.0.1:3000 && npm run dev:main:electron",
    "dev:main:electron": "cross-env NODE_ENV=development electron --disable-gpu dist/main/main.js",
    "dev:renderer": "cross-env NODE_ENV=development webpack serve --mode development --config webpack.config.js",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.json --outDir dist",
    "build:renderer": "webpack --mode production --config webpack.config.js",
    "build:tests": "tsc -p tsconfig.tests.json",
    "validate": "npm run build:tests && node dist-tests/testOrchestrator.js",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win nsis",
    "dist:portable": "npm run build && electron-builder --config electron-builder.yml --win portable",
    "release:stable": "cross-env UPDATE_CHANNEL=stable npm run dist -- --publish always",
    "release:beta": "cross-env UPDATE_CHANNEL=beta npm run dist -- --publish always",
    "start": "cross-env NODE_ENV=production electron --disable-gpu dist/main/main.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.20.0",
    "@types/dom-speech-recognition": "^0.0.11",
    "@types/styled-components": "^5.1.36",
    "axios": "^1.6.0",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.3.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "event-emitter": "^0.3.5",
    "express": "^4.18.2",
    "google-auth-library": "^10.6.2",
    "pg": "^8.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "styled-components": "^6.4.1",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "electron": "^27.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.50.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "prisma": "^5.20.0",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.2",
    "wait-on": "^7.0.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.1"
  }
}
